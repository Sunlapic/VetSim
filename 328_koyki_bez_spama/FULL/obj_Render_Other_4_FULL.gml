/// Room Start obj_Render
/// @description Сборка обстановки клиники. Пакеты №300 и №301.
///
/// Room Start срабатывает и при первом входе в комнату, и при каждом
/// переходе в другую клинику. Поэтому здесь собирается всё, что зависит
/// от геометрии конкретной комнаты: сетка путей, точки ожидания, вход.
///
/// Важно, что это НЕ Create: Create отрабатывает раз на создание объекта
/// и хранит прогресс игры (деньги, день, репутацию), а Room Start —
/// каждый вход в комнату и хранит только обстановку.

clinic_scene_init(id);


// ПАКЕТ №328: в новой комнате предупреждения о несобранных койках
// можно показать заново — в прошлой комнате они уже прозвучали.
// Без сброса диагностика печаталась бы только раз за всю игру.
global.inpatient_warned = {};


// ═══════════════════════════════════════════════════════════════
// ПАКЕТ №306: КАКАЯ КЛИНИКА ОТКРЫТА
//
// Обязательно ДО разворачивания персонала. При запуске игры
// active_clinic равен 1 независимо от стартовой комнаты, и без этой
// строки игра считала персонал тестовой комнаты штатом клиники №1.
// ═══════════════════════════════════════════════════════════════

clinic_sync_active();


// ПАКЕТ №309: переход завершён — снимаем защиту от сохранения,
// чтобы обычный выход из игры снова записывал прогресс.
global.clinic_room_transition = false;


// ═══════════════════════════════════════════════════════════════
// ПАКЕТ №325: СОСТОЯНИЕ ЭТОЙ КЛИНИКИ В ОБЩИЕ ПЕРЕМЕННЫЕ
//
// У каждой клиники своя репутация, свои построенные помещения и свои
// уровни улучшений. Всё это лежит в кармане клиники
// (global.clinic_state.clinic_N), а остальная игра смотрит в
// global.clinic_reputation / clinic_rooms_open / clinic_upgrades.
//
// clinic_apply_current подменяет общие значения на местные. Она же
// разбирается с первым входом: если карман ещё пуст, стартовым
// состоянием считается один кабинет приёма и репутация из данных
// клиники — а не то, что осталось от предыдущей клиники.
// ═══════════════════════════════════════════════════════════════

if (script_exists(asset_get_index("clinic_apply_current"))) {
    clinic_apply_current();
}


// ═══════════════════════════════════════════════════════════════
// ПАКЕТ №301: ПЕРСОНАЛ И СКЛАД ЭТОЙ КЛИНИКИ
//
// Флаг ставит clinics_enter перед room_goto. Разворачивать персонал
// там нельзя: в момент вызова объектов новой комнаты ещё не
// существует. Здесь они уже созданы.
//
// Обычный запуск игры этот блок пропускает — флага нет, стартовый
// персонал из редактора комнаты остаётся как есть.
// ═══════════════════════════════════════════════════════════════

if (
    variable_global_exists("clinic_restore_pending")
    && global.clinic_restore_pending
) {
    global.clinic_restore_pending = false;

    clinic_network_restore(
        variable_global_exists("active_clinic")
            ? global.active_clinic
            : 1
    );
}
