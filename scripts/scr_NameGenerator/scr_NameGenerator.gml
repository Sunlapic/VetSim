function get_random_name(_is_female) {
    var _first_name = "";
    var _last_name = "";

    if (_is_female) {
        // --- ЖЕНСКИЕ ИМЕНА (50+) ---
        var _f_names = ["Анна", "Елена", "Мария", "Ольга", "Наталья", "Екатерина", "Дарья", "Ирина", "Светлана", "Юлия", "Татьяна", "Оксана", "Виктория", "Алина", "Людмила", "Полина", "Ксения", "Анастасия", "Вера", "Надежда"]; 
        // (Добавь сюда еще до 50-100 имен)
        _first_name = _f_names[irandom(array_length(_f_names) - 1)];

        // --- ЖЕНСКИЕ ФАМИЛИИ (Меняем окончание) ---
        var _surnames = ["Иванов", "Петров", "Смирнов", "Соколов", "Кузнецов", "Попов", "Васильев", "Морозов", "Новиков", "Волков", "Федоров", "Лебедев", "Козлов", "Белов", "Орлов"];
        // (Добавь сюда еще до 300 фамилий в мужском роде)
        _last_name = _surnames[irandom(array_length(_surnames) - 1)];
        
        // Автоматически добавляем "а", если фамилия на "ов", "ев" или "ин"
        if (string_copy(_last_name, string_length(_last_name)-1, 2) == "ов") _last_name += "а";
        else if (string_copy(_last_name, string_length(_last_name)-1, 2) == "ев") _last_name += "а";
        else if (string_copy(_last_name, string_length(_last_name)-1, 2) == "ин") _last_name += "а";
    } 
    else {
        // --- МУЖСКИЕ ИМЕНА (50+) ---
        var _m_names = ["Виктор", "Дмитрий", "Сергей", "Марк", "Артем", "Павел", "Андрей", "Алексей", "Максим", "Игорь", "Денис", "Михаил", "Николай", "Олег", "Александр", "Роман", "Вадим", "Кирилл", "Антон", "Егор"];
        _first_name = _m_names[irandom(array_length(_m_names) - 1)];

        // --- МУЖСКИЕ ФАМИЛИИ ---
        var _surnames = ["Иванов", "Петров", "Смирнов", "Соколов", "Кузнецов", "Попов", "Васильев", "Морозов", "Новиков", "Волков", "Федоров", "Лебедев", "Козлов", "Белов", "Орлов"];
        _last_name = _surnames[irandom(array_length(_surnames) - 1)];
    }

    return _first_name + " " + _last_name;
}