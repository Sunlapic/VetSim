//
// sh_scrub_pattern — цвет и узоры одежды (Пакет 248, V22 — ищите V22 в этой строке)
// u_pattern: 0 гладь, 1 полоски, 2 клетка, 3 кружки, 4 ромбики
//
// v22: в ПЛОСКОМ режиме (u_simple) идеально нейтрально-серые пиксели
//      диапазона руки (lum 0.55-0.695, каналы равны ±3) НЕ красятся:
//      рука-манекен (153-176) остаётся серой в робах посетителей и
//      ассистентов. Ткань робы слегка тёплая — под правило не попадает
//      (проверено по всем палитрам: совпадений ноль; покрытие руки 98.2%).
// v21: и ТЁПЛЫЕ пиксели в одежде — НЕ КРАСИТЬ (возвращено поведение
//      V5/V15: col = c, пятен не было). Пятна были от V17-правила
//      «тёплое красить кожей»: слегка тёплые тени ткани на робах
//      красились кожей. Кожа (и по тёплому, и по серому) — только
//      телу посетителя при u_skin=1.
// v20: перекраска серого в кожу (ветка mannequin) — ТОЛЬКО при
//      u_skin=1 (тело посетителя). V19 красил кожу из серого ВСЕГДА —
//      и на ОДЕЖДЕ серые тени ткани превращались в кожаные ПЯТНА
//      («просвечивало тело»). Одежда: серое остаётся как есть.
// v19: ФИНАЛ. Найдена причина «белой кисти»: у кисти в арте халата
//      бледно-серая СЕРДЦЕВИНА (lum 0.60-0.65) — её «защищал как
//      манекен» тот же механизм, что серую руку. Защищённая = бледная
//      = белая. Теперь ВСЯ кисть в одежде (тёплая кромка И серая
//      сердцевина 0.55-0.74) красится эталонной кожей. Халаты —
//      лёгкие оттенки. Перчаток нет. Оверлей-спрайтов нет.
// v18: ПЕРЧАТКИ ОТМЕНЕНЫ навсегда (u_glove удалён). Кисти в одежде
//      всегда эталонная кожа. Кисть врача поверх халата рисуется
//      отдельными спрайтами HandTop (как ArmTop у ассистента) —
//      см. Пакет 236.
// v17: кисти ОКРАШИВАЮТСЯ в эталонную кожу (226,177,117), а не
//      «защищаются как есть»: кисть в арте бледная (размывка по белой
//      ткани) — защищённая выглядела БЕЛОЙ рядом с пастельным халатом.
//      Тёплые пиксели в спрайтах одежды — только кисти, ткань не
//      тёплая, поэтому красим их спокойно. Тот же механизм красит
//      кисти в белый при u_glove=1 (рабочая поза) — ПЕРЧАТКИ.
// v16: кожа определяется по ОТТЕНКУ (r>g>b), а не по глубине тона.
//      Кисть в спрайтах халата бледная (ядро r−g≈0.17, края ≥0.03),
//      старый фильтр требовал r−g>0.08 и пропускал большую часть кисти.
//      Ткань халата почти нейтральна (r−g≈0.016) — отделена с запасом.
//      + u_glove: в рабочей позе тёплые пиксели (кисти) белеют — ПЕРЧАТКИ.
// v15: халаты снова красятся. Ткань халата в арте — светло-серая
//      нейтральная (база 245, тень 201), v14 защищала её как «руку» —
//      все халаты стали белыми. Теперь нейтральность защищает руку
//      только НИЖЕ MANNEQUIN_LUM: рука манекена 153-176 (замер по
//      эталону), ткань халата 201+ — порог 188 даёт зазор с обеих
//      сторон. Кисти в спрайтах халата должны быть ТЕЛЕСНЫМИ (тёплый
//      фильтр защищает их на любой яркости).
// v14: серая рука-манекен защищена от окраски при ЛЮБОЙ яркости
//      (раньше — только тёмная: светлые края/блики руки красились
//      как ткань, и «рукав красился»). Ткань отличаем по тёплому
//      оттенку (R−B ≈ 9+), рука идеально нейтральна (R−B ≤ 5).
// v13: u_simple — ПЛОСКАЯ заливка обуви: всё внутри силуэта красится
//      однотонно (u_base), только зона ниже порога яркости даёт одну
//      единственную тень (u_base*SHOE_SHADE), контур остаётся чёрным.
//      Никакие пятна/штриховка спрайта не влияют — только силуэт.
//      v12 (цвет по яркости) не убрал яркостные пятна — v13 убирает.
// v10: тень не светлее базового цвета — на тёмной одежде
//      (чёрные штаны, тёмные ботинки) больше нет светлых полос.
// v9:  рука-манекен не красится (она идеально нейтрально-серая,
//      а тени ткани чуть тёплые).
//
// НЕ КРАСЯТСЯ: кожа/картон (тёплые), металл ящиков (синий>красного),
// серые руки-манекены (нейтральный серый ниже порога яркости).
//
// НАСТРОЙКИ — константы ниже:
//   FABRIC_CUT     порог ткань/тень
//   NEUTRAL_TOL    допуск «серости манекена»
//   MANNEQUIN_LUM   порог яркости защиты руки (выше = ткань, красится)
//   SHADOW_GRAY    притягивающий серый для теней светлой ткани
//   SHADOW_NEUTRAL 0=тень цветная, 1=тень серая
//   SKIN_RG/GB     порог оттенка кожи (меньше = строже)
//   SKIN_BASE/     эталонный телесный цвет кистей в одежде
//   0.55 в ветке mannequin — порог «сердцевина кисти / контур»
//

const float FABRIC_CUT     = 0.635;
const float EDGE_AA        = 0.02;
const float NEUTRAL_TOL    = 0.022;
const float MANNEQUIN_LUM   = 0.74;  // порог защиты руки: рука <=176/255, ткань халата >=201/255
const float SHADOW_GRAY    = 0.62;
const float SHADOW_NEUTRAL = 0.55;
const float STRIPES        = 18.0;
const float GRID           = 12.0;
const float DOTS           = 12.0;
const float DIAMONDS       = 12.0;
const float DOT_R          = 0.34;
const float DIA_R          = 0.30;
const float PATTERN_POWER  = 0.78;
const float SHOE_SHADE     = 0.82;  // глубина единственной тени обуви
const float SKIN_RG       = 0.028; // мин. r−g для кожи (ткань халата ~0.016)
const float SKIN_GB       = 0.016; // мин. g−b для кожи
const vec3  SKIN_BASE     = vec3(0.886, 0.695, 0.459); // кожа: база 226,177,117
const vec3  SKIN_SHADE    = vec3(0.835, 0.643, 0.420); // кожа: тень 213,164,107

varying vec2 v_vTexcoord;
varying vec4 v_vColour;

uniform vec3  u_base;
uniform float u_pattern;
uniform vec2  u_uv0;
uniform vec2  u_uvspan;
uniform float u_psize;
uniform float u_pphase;
uniform float u_simple;   // 1 = красить всё подряд (обувь), 0 = с фильтрами
uniform float u_skin;     // 1 = серые манекены красить кожей (тело посетителя)

void main()
{
    vec4 tex = texture2D( gm_BaseTexture, v_vTexcoord );
    if (tex.a < 0.01) discard;

    vec3  c   = tex.rgb;
    float lum = dot(c, vec3(0.333));

    // v16: кожа по оттенку r>g>b (см. шапку) — бледная кисть тоже кожа
    bool warm = (c.r > c.g + SKIN_RG) && (c.g > c.b + SKIN_GB) && (c.r > 0.47);
    bool metal = (c.b > c.r);

    bool neutral = (abs(c.r - c.g) < NEUTRAL_TOL)
                && (abs(c.g - c.b) < NEUTRAL_TOL)
                && (abs(c.r - c.b) < NEUTRAL_TOL * 1.4);
    // v15: нейтральность защищает руку только ниже MANNEQUIN_LUM —
    // светлой нейтральной ткани халата (201+) это не блокирует.
    bool mannequin = neutral && (lum < MANNEQUIN_LUM);

    float k_col = smoothstep(FABRIC_CUT, FABRIC_CUT + EDGE_AA, lum);
    vec3 tint_full   = u_base;
    vec3 tint_shadow = min(mix(u_base, vec3(SHADOW_GRAY), SHADOW_NEUTRAL), u_base);

    vec3 col;
    if (u_simple > 0.5) {
        // обувь: ПЛОСКАЯ заливка — пятна/штриховка спрайта не влияют;
        // одна тень по порогу + чёрный контур остаются
        float shoe_lum = dot(c, vec3(0.333));
        // v22: серая рука-манекен в плоской заливке не красится
        float mx_c = max(c.r, max(c.g, c.b));
        float mn_c = min(c.r, min(c.g, c.b));
        bool arm_gray = (mx_c - mn_c <= 0.025) && (shoe_lum > 0.55) && (shoe_lum < 0.695);
        if (arm_gray) {
            col = c;                                  // серая рука — как есть
        } else if (shoe_lum < 0.35) {
            col = c;                                  // контур
        } else if (shoe_lum < 0.68) {
            col = u_base * SHOE_SHADE;                // единая тень
        } else {
            col = u_base;                             // основной тон
        }
    } else if (warm) {
        // v21: в одежде тёплые пиксели НЕ трогаем (как в V5/V15 —
        // без пятен); кожу из них делаем только телу (u_skin)
        col = (u_skin > 0.5) ? mix(SKIN_SHADE, SKIN_BASE, k_col) : c;
    } else if (metal || mannequin) {
        // v19: тусклая серая сердцевина кисти в спрайтах одежды —
        // тоже КОЖА (раньше «защищалась» и выглядела белой);
        // темнее 0.55 — контур/глубокая тень, остаётся как есть
        col = (mannequin && lum > 0.55 && u_skin > 0.5)
                  ? mix(SKIN_SHADE, SKIN_BASE, k_col) : c;
    } else {
        col = mix(c * tint_shadow, c * tint_full, k_col);
    }

    float k_pat = smoothstep(0.55, 0.75, lum) * k_col;

    if (k_pat > 0.001 && u_pattern > 0.5) {
        vec2 local = (v_vTexcoord - u_uv0) / max(u_uvspan, vec2(1e-6));
        local += vec2(u_pphase, u_pphase * 0.7371);

        float m = 0.0;
        if (u_pattern < 1.5) {
            m = step(0.5, fract(local.y * STRIPES * u_psize));
        } else if (u_pattern < 2.5) {
            float fx = step(0.90, fract(local.x * GRID * u_psize));
            float fy = step(0.90, fract(local.y * GRID * u_psize));
            m = max(fx, fy);
        } else if (u_pattern < 3.5) {
            vec2 g = fract(local * DOTS * u_psize) - 0.5;
            m = step(length(g), DOT_R);
        } else {
            vec2 g = abs(fract(local * DIAMONDS * u_psize) - 0.5);
            m = step(g.x + g.y, DIA_R);
        }
        col = mix(col, col * PATTERN_POWER, m * k_pat);
    }

    gl_FragColor = vec4(col, tex.a) * v_vColour;
}
