//
// sh_scrub_pattern — цвет и узоры одежды (Пакет 251, V24 — ищите V24 в этой строке)
// u_pattern: 0 гладь, 1 полоски, 2 клетка, 3 кружки, 4 ромбики
//
// v24 (ПАКЕТ 251): две правки по итогам проверки 250.
//   А) ЗАДНЯЯ РУКА ОСТАВАЛАСЬ СЕРОЙ. Спрайт ArmTop покрывает только
//      ближнюю руку. Дальняя рука впечена в САМО ТЕЛО, а тело
//      рисовалось вообще без шейдера (так вернули в 247) — то есть
//      задняя рука не окрашивалась в принципе, ни в 250, ни раньше.
//      Теперь тело рисуется через шейдер с u_skin = 1. Торс и ноги
//      всё равно закрыты одеждой, видимый эффект — ровно задняя рука.
//      Побочно: ARM_LUM_HI поднят 157 -> 162, потому что вид СЗАДИ
//      светлее (доминанта 161 против 157 спереди). На цвет это почти
//      не влияет (237,195,170 -> 236,194,169), но возвращает задней
//      руке светотень: при HI = 157 весь диапазон 161 упирался в
//      clamp = 1.0 и рука заливалась одним плоским тоном.
//   Б) БЕЛЫЕ ПРОСВЕТЫ НА БОТИНКАХ. Правило V22 «серую руку не красить»
//      работало в плоском режиме ВСЕГДА, в том числе на обуви и штанах,
//      где никакой руки нет. Нейтрально-серые пиксели обуви той же
//      яркости оставались некрашеными и светились на тёмном ботинке.
//      Введён u_armguard: 1 только для роб/халатов, 0 для обуви,
//      кроксов и штанов.
//
// v23 (ПАКЕТ 250): СВЕТЛАЯ КОЖА РУК.
//      Проблема: рука владельца выходила ТЁМНОЙ и слишком оранжевой
//      рядом с головой и ладонью. Причина — эталон SKIN_BASE был
//      226,177,117, а в арте головы и кистей кожа = 237,195,170
//      (замер по spr_human_FR_walk / _idle / _sit: 103 173 кожаных
//      пикселя, доминанта 237,195,170, lum 201). Старый эталон темнее
//      на 11 по R, на 18 по G и на 53 (!) по B — отсюда тёмный
//      «загорелый» тон вместо светлой кожи головы.
//      Что сделано:
//        1. SKIN_BASE = 237,195,170 — ровно тон головы и ладоней.
//        2. SKIN_SHADE = 216,172,149 — мягкая тень (0.91 от базы),
//           а не глухая 213,164,107.
//        3. Серая рука-манекен красится с СОХРАНЕНИЕМ светотени:
//           яркость серого (диапазон 153-176) нормализуется в
//           t = 0..1 и по нему смешиваются SKIN_SHADE → SKIN_BASE.
//           Раньше k_col давал на этом диапазоне ровно 0, то есть
//           вся рука заливалась одной самой тёмной тенью.
//        4. Тёплые пиксели при u_skin=1 НЕ перекрашиваются: кисть
//           в арте уже правильного цвета 237,195,170 — трогать её
//           значит рисковать рассинхроном с головой.
//      ЕСЛИ НАДО ЕЩЁ СВЕТЛЕЕ: поднимайте SKIN_SHADE к SKIN_BASE
//      (например 224,182,158). Саму SKIN_BASE менять не нужно —
//      она обязана совпадать с головой.
// v22: в ПЛОСКОМ режиме (u_simple) идеально нейтрально-серые пиксели
//      диапазона руки (lum 0.55-0.695, каналы равны ±3) НЕ красятся:
//      рука-манекен (153-176) остаётся серой в робах посетителей и
//      ассистентов. Ткань робы слегка тёплая — под правило не попадает
//      (проверено по всем палитрам: совпадений ноль; покрытие руки 98.2%).
// v21: и ТЁПЛЫЕ пиксели в одежде — НЕ КРАСИТЬ (возвращено поведение
//      V5/V15: col = c, пятен не было). Пятна были от V17-правила
//      «тёплое красить кожей»: слегка тёплые тени ткани на робах
//      красились кожей. Кожа (и по тёплому, и по серому) — только
//      телу посетителя при u_skin=1.
// v20: перекраска серого в кожу (ветка mannequin) — ТОЛЬКО при
//      u_skin=1 (тело посетителя). V19 красил кожу из серого ВСЕГДА —
//      и на ОДЕЖДЕ серые тени ткани превращались в кожаные ПЯТНА
//      («просвечивало тело»). Одежда: серое остаётся как есть.
// v19: ФИНАЛ. Найдена причина «белой кисти»: у кисти в арте халата
//      бледно-серая СЕРДЦЕВИНА (lum 0.60-0.65) — её «защищал как
//      манекен» тот же механизм, что серую руку. Защищённая = бледная
//      = белая. Теперь ВСЯ кисть в одежде (тёплая кромка И серая
//      сердцевина 0.55-0.74) красится эталонной кожей. Халаты —
//      лёгкие оттенки. Перчаток нет. Оверлей-спрайтов нет.
// v18: ПЕРЧАТКИ ОТМЕНЕНЫ навсегда (u_glove удалён). Кисти в одежде
//      всегда эталонная кожа. Кисть врача поверх халата рисуется
//      отдельными спрайтами HandTop (как ArmTop у ассистента) —
//      см. Пакет 236.
// v17: кисти ОКРАШИВАЮТСЯ в эталонную кожу, а не «защищаются как
//      есть»: кисть в арте бледная (размывка по белой ткани) —
//      защищённая выглядела БЕЛОЙ рядом с пастельным халатом.
// v16: кожа определяется по ОТТЕНКУ (r>g>b), а не по глубине тона.
// v15: халаты снова красятся; нейтральность защищает руку только
//      ниже MANNEQUIN_LUM (рука 153-176, ткань халата 201+).
// v14: серая рука-манекен защищена от окраски при ЛЮБОЙ яркости.
// v13: u_simple — ПЛОСКАЯ заливка обуви.
// v10: тень не светлее базового цвета.
// v9:  рука-манекен не красится.
//
// НЕ КРАСЯТСЯ: кожа/картон (тёплые), металл ящиков (синий>красного),
// серые руки-манекены (нейтральный серый ниже порога яркости).
//
// НАСТРОЙКИ — константы ниже:
//   FABRIC_CUT     порог ткань/тень
//   NEUTRAL_TOL    допуск «серости манекена»
//   MANNEQUIN_LUM   порог яркости защиты руки (выше = ткань, красится)
//   SHADOW_GRAY    притягивающий серый для теней светлой ткани
//   SHADOW_NEUTRAL 0=тень цветная, 1=тень серая
//   SKIN_RG/GB     порог оттенка кожи (меньше = строже)
//   SKIN_BASE      эталонный телесный цвет = кожа головы и ладоней
//   SKIN_SHADE     тень кожи (поднимайте к базе, если нужно светлее)
//   ARM_LUM_LO/HI  диапазон яркости серой руки-манекена
//

const float FABRIC_CUT     = 0.635;
const float EDGE_AA        = 0.02;
const float NEUTRAL_TOL    = 0.022;
const float MANNEQUIN_LUM   = 0.74;  // порог защиты руки: рука <=176/255, ткань халата >=201/255
const float SHADOW_GRAY    = 0.62;
const float SHADOW_NEUTRAL = 0.55;
const float STRIPES        = 18.0;
const float GRID           = 12.0;
const float DOTS           = 12.0;
const float DIAMONDS       = 12.0;
const float DOT_R          = 0.34;
const float DIA_R          = 0.30;
const float PATTERN_POWER  = 0.78;
const float SHOE_SHADE     = 0.82;  // глубина единственной тени обуви
const float SKIN_RG       = 0.028; // мин. r−g для кожи (ткань халата ~0.016)
const float SKIN_GB       = 0.016; // мин. g−b для кожи

// v23: эталон = замеренная кожа головы и ладоней в spr_human_*
const vec3  SKIN_BASE     = vec3(0.929, 0.765, 0.667); // кожа: база 237,195,170
const vec3  SKIN_SHADE    = vec3(0.847, 0.675, 0.584); // кожа: тень 216,172,149

// v24 (ПАКЕТ 251): диапазон яркости серой руки-манекена.
// Замер раздельно по видам:
//     spr_human_FR_walk (спереди) — доминанта 157
//     spr_human_B_walk  (СЗАДИ)   — доминанта 161  ← вид сзади СВЕТЛЕЕ
// В v23 стоял HI = 0.616 (157/255), рассчитанный по виду СПЕРЕДИ.
// Задняя рука (161) оказывалась ВЫШЕ этого потолка, clamp давал
// k_arm = 1.0 на всём предплечье... но главная беда была не в этом,
// а в MANNEQUIN_LUM и пороге neutral — см. NEUTRAL_TOL ниже.
// Теперь HI = 0.635 (162/255) перекрывает обе доминанты: и 157,
// и 161 получают базовый тон кожи, светотень сохраняется у обоих.
const float ARM_LUM_LO    = 0.500;   // 127/255 — граница контура
const float ARM_LUM_HI    = 0.635;   // 162/255 — перекрывает FR(157) и B(161)

varying vec2 v_vTexcoord;
varying vec4 v_vColour;

uniform vec3  u_base;
uniform float u_pattern;
uniform vec2  u_uv0;
uniform vec2  u_uvspan;
uniform float u_psize;
uniform float u_pphase;
uniform float u_simple;   // 1 = красить всё подряд (обувь), 0 = с фильтрами
uniform float u_skin;     // 1 = серые манекены красить кожей (рука/тело)
uniform float u_armguard; // 1 = в спрайт впечена рука-манекен, не красить её
                          //     (робы/халаты). 0 = руки в спрайте нет —
                          //     красить весь силуэт (обувь, штаны, кроксы)

void main()
{
    vec4 tex = texture2D( gm_BaseTexture, v_vTexcoord );
    if (tex.a < 0.01) discard;

    vec3  c   = tex.rgb;
    float lum = dot(c, vec3(0.333));

    // v16: кожа по оттенку r>g>b (см. шапку) — бледная кисть тоже кожа
    bool warm = (c.r > c.g + SKIN_RG) && (c.g > c.b + SKIN_GB) && (c.r > 0.47);
    bool metal = (c.b > c.r);

    bool neutral = (abs(c.r - c.g) < NEUTRAL_TOL)
                && (abs(c.g - c.b) < NEUTRAL_TOL)
                && (abs(c.r - c.b) < NEUTRAL_TOL * 1.4);
    // v15: нейтральность защищает руку только ниже MANNEQUIN_LUM —
    // светлой нейтральной ткани халата (201+) это не блокирует.
    bool mannequin = neutral && (lum < MANNEQUIN_LUM);

    float k_col = smoothstep(FABRIC_CUT, FABRIC_CUT + EDGE_AA, lum);
    vec3 tint_full   = u_base;
    vec3 tint_shadow = min(mix(u_base, vec3(SHADOW_GRAY), SHADOW_NEUTRAL), u_base);

    // v23: светотень серой руки, нормализованная в 0..1.
    // Раньше здесь работал k_col, который на диапазоне руки
    // (0.55-0.70) почти всегда равен 0 → вся рука заливалась
    // самой тёмной тенью. Теперь тон руки следует за артом.
    float k_arm = clamp((lum - ARM_LUM_LO) / (ARM_LUM_HI - ARM_LUM_LO), 0.0, 1.0);

    vec3 col;
    if (u_simple > 0.5) {
        // обувь: ПЛОСКАЯ заливка — пятна/штриховка спрайта не влияют;
        // одна тень по порогу + чёрный контур остаются
        float shoe_lum = dot(c, vec3(0.333));
        // v24 (ПАКЕТ 251): защита впечённой руки — ТОЛЬКО при u_armguard = 1.
        // Раньше правило действовало ВСЕГДА, и на ботинках/штанах
        // нейтрально-серые пиксели (та же яркость 157-161, что у руки)
        // оставались НЕПОКРАШЕННЫМИ — на тёмной обуви это читалось
        // как светлые просветы/дыры. В обуви и штанах руки нет,
        // защищать нечего: u_armguard = 0 → красится весь силуэт.
        float mx_c = max(c.r, max(c.g, c.b));
        float mn_c = min(c.r, min(c.g, c.b));
        bool arm_gray = (u_armguard > 0.5)
                     && (mx_c - mn_c <= 0.025)
                     && (shoe_lum > 0.55) && (shoe_lum < 0.72);
        if (arm_gray) {
            col = c;                                  // серая рука — как есть
        } else if (shoe_lum < 0.35) {
            col = c;                                  // контур
        } else if (shoe_lum < 0.68) {
            col = u_base * SHOE_SHADE;                // единая тень
        } else {
            col = u_base;                             // основной тон
        }
    } else if (warm) {
        // v23: тёплые пиксели НЕ трогаем НИКОГДА. В арте это уже
        // готовая кожа 237,195,170 — ровно как голова. Перекрашивать
        // её значит рисковать рассинхроном с лицом.
        col = c;
    } else if (metal || mannequin) {
        // v23: серая рука-манекен → светлая кожа со своей светотенью;
        // темнее ARM_LUM_LO — контур/глубокая тень, остаётся как есть
        col = (mannequin && lum > ARM_LUM_LO && u_skin > 0.5)
                  ? mix(SKIN_SHADE, SKIN_BASE, k_arm) : c;
    } else {
        col = mix(c * tint_shadow, c * tint_full, k_col);
    }

    float k_pat = smoothstep(0.55, 0.75, lum) * k_col;

    if (k_pat > 0.001 && u_pattern > 0.5) {
        vec2 local = (v_vTexcoord - u_uv0) / max(u_uvspan, vec2(1e-6));
        local += vec2(u_pphase, u_pphase * 0.7371);

        float m = 0.0;
        if (u_pattern < 1.5) {
            m = step(0.5, fract(local.y * STRIPES * u_psize));
        } else if (u_pattern < 2.5) {
            float fx = step(0.90, fract(local.x * GRID * u_psize));
            float fy = step(0.90, fract(local.y * GRID * u_psize));
            m = max(fx, fy);
        } else if (u_pattern < 3.5) {
            vec2 g = fract(local * DOTS * u_psize) - 0.5;
            m = step(length(g), DOT_R);
        } else {
            vec2 g = abs(fract(local * DIAMONDS * u_psize) - 0.5);
            m = step(g.x + g.y, DIA_R);
        }
        col = mix(col, col * PATTERN_POWER, m * k_pat);
    }

    gl_FragColor = vec4(col, tex.a) * v_vColour;
}
