/// Draw obj_owner
/// @description Владелец и шкала ожидания над головой.


// ═══════════════════════════════════════════════════════════════
// 1. ОСНОВНАЯ ОТРИСОВКА ВЛАДЕЛЬЦА
// Тело, голова, подсветка и овальная тень рисуются в par_visitors.
// ═══════════════════════════════════════════════════════════════

event_inherited();


// ═══════════════════════════════════════════════════════════════
// 2. ПРОВЕРКА ШКАЛЫ ОЖИДАНИЯ
// ═══════════════════════════════════════════════════════════════

var _show_wait_bar = (
    variable_instance_exists(id, "action_progress_active")
    && action_progress_active
);

if (_show_wait_bar) {
    var _current_value = variable_instance_exists(id, "action_progress_timer")
        ? action_progress_timer
        : 0;

    var _maximum_value = variable_instance_exists(id, "action_progress_timer_max")
        ? max(1, action_progress_timer_max)
        : 1;

    var _ratio = clamp(
        _current_value / _maximum_value,
        0,
        1
    );


    // ═══════════════════════════════════════════════════════════
    // 3. ПАКЕТ №330: ЦВЕТ ПО ПРИЧИНЕ ОЖИДАНИЯ
    //
    // Раньше цветов было два: зелёный (приём) и синий (назначения),
    // и обе очереди у стойки выглядели одинаково. Теперь цвет
    // показывает, ЧЕГО именно ждёт клиент:
    //
    //   янтарный  — ждёт оплаты        (queue_purpose == "payment")
    //   голубой   — ждёт регистратуру  (registered == false)
    //   зелёный   — ждёт приёма врача
    //   фиолетовый — ждёт манипуляций   (service_queue_type)
    //   розовый   — стационар
    //   красный   — терпение на исходе (любой тип)
    //
    // Палитра и пороги — в скрипте wait_bar_system.
    // ═══════════════════════════════════════════════════════════

    var _bar_color = wait_bar_owner_color(id, _ratio);


    // ═══════════════════════════════════════════════════════════
    // 4. ПАКЕТ №330: ПОЛОСКА ЧЁТКО НАД ГОЛОВОЙ
    //
    // Прежние смещения были зашиты в коде: −142 стоя и −82 сидя.
    // Замер по спрайтам показал ошибку именно в сидящем:
    //
    //   spr_human_FR_walk — макушка y − 116 → полоска на −142 верно;
    //   spr_human_FR_sit  — макушка y − 95, с поправкой +21 из
    //                       par_visitors → y − 73. Полоска на −82
    //                       оказывалась на 11 пикселей НИЖЕ макушки,
    //                       то есть на уровне глаз.
    //
    // Теперь позицию считает wait_bar_position(): она берёт признак
    // сидящего (_owner_sitting из par_visitors → Step End) и
    // макросы WAIT_BAR_HEAD_STAND / WAIT_BAR_HEAD_SIT. Зазор над
    // макушкой один и тот же — WAIT_BAR_GAP.
    //
    // Оформление — draw_wait_bar(): капсула со скруглёнными краями,
    // тонкой чёрной обводкой и пустой дорожкой, поэтому всегда
    // видно, сколько уже прошло. Вариант выбирается макросом
    // WAIT_BAR_STYLE (1–6), клавиша V в отладке показывает все шесть.
    // ═══════════════════════════════════════════════════════════

    var _bar_pos = wait_bar_position();

    draw_wait_bar(
        _bar_pos.x1,
        _bar_pos.y1,
        _bar_pos.x2,
        _bar_pos.y2,
        _ratio,
        _bar_color,
        -1
    );
}



// ═══════════════════════════════════════════════════════════════
// 5. СБРОС DRAW
// ═══════════════════════════════════════════════════════════════

draw_set_color(c_white);
draw_set_alpha(1);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
gpu_set_blendmode(bm_normal);
