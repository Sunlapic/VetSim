/// Create obj_UI_Tablet
/// @description Базовое состояние планшета и визуальных эффектов.


// ═══════════════════════════════════════════════════════════════
// 1. СОСТОЯНИЕ ПЛАНШЕТА
// ═══════════════════════════════════════════════════════════════

visible = false;
target_id = noone;
my_sprite = spr_ui_clipboard_grey;
ui_scale = 1.8;


// ═══════════════════════════════════════════════════════════════
// 2. ЗАЩИТА ОТ СЛУЧАЙНЫХ КЛИКОВ
// ═══════════════════════════════════════════════════════════════

tablet_click_lock = 0;
tablet_was_open = false;
tablet_last_target_id = noone;
tablet_open_delay_frames = max(1, game_get_speed(gamespeed_fps) div 4);


// ═══════════════════════════════════════════════════════════════
// 3. ПОДСВЕТКА СОСТОЯНИЯ ПАЦИЕНТА
// ═══════════════════════════════════════════════════════════════

condition_flash_timer = 0;
condition_flash_timer_max = max(1, game_get_speed(gamespeed_fps) div 3);
condition_flash_color = make_color_rgb(70, 210, 90);


// ════════════════════════════════════════════════════════════════
// ПАКЕТ №288: СТРАНИЦЫ ПРАВОЙ КОЛОНКИ
//
// Раньше справа всегда висели две половинные панели.
// Теперь панель одна во всю высоту, а внутри неё сменяются
// страницы — кнопки влезают вдвое крупнее.
//
// Страница хранится на планшете, а не в кейсе животного:
// это состояние окна, а не данные пациента, и в сейв ему не надо.
// ════════════════════════════════════════════════════════════════

card_page = 0;

// За каким животным сейчас следим. Смена пациента сбрасывает
// страницу на обследования и гасит недоигранную анимацию.
card_page_animal = noone;

// Диагноз был подтверждён на прошлом кадре? По переходу
// false → true запускаются переворот листа и вспышка.
card_diagnosis_was_confirmed = false;


// ════════════════════════════════════════════════════════════════
// ПАКЕТ №288: ТАЙМЕРЫ ПЕРЕВОРОТА И ВСПЫШКИ
//
// Переворот короткий — около половины секунды, чтобы не
// задерживать игрока. Вспышка держится дольше, чтобы её
// точно заметить даже если взгляд был в другом углу экрана.
// ════════════════════════════════════════════════════════════════

card_flip_timer = 0;
card_flip_timer_max = max(1, (game_get_speed(gamespeed_fps) * 5) div 9);

card_diagnosis_flash_timer = 0;
card_diagnosis_flash_timer_max = max(1, game_get_speed(gamespeed_fps) + (game_get_speed(gamespeed_fps) div 2));


// ═══════════════════════════════════════════════════════════════
// 4. ЛЕТЯЩИЕ ПЛЮСЫ И МИНУСЫ
// ═══════════════════════════════════════════════════════════════

fly_effects = [];
