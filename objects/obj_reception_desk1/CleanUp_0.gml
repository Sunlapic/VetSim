/// Cleanup obj_reception_desk
/// @description Очистка стойки
///
/// ═══════════════════════════════════════════════════════════════
/// ПАКЕТ №310: ПРОВЕРКА, ЧТО ПЕРЕМЕННАЯ ВООБЩЕ СОЗДАНА
///
/// Здесь стояло сразу `ds_exists(queue_list, ...)`, и при смене
/// комнаты игра падала:
///
///     Variable obj_reception_desk.queue_list not set before reading it
///
/// Причина в порядке событий GameMaker. Объекты комнаты создаются
/// по очереди, а CleanUp при смене комнаты приходит ко ВСЕМ сразу.
/// Если переход случился раньше, чем очередь дошла до Create этой
/// стойки, переменной queue_list ещё не существует — а ds_exists
/// требует уже существующую переменную, проверить несозданную она
/// не может.
///
/// variable_instance_exists спрашивает ровно то, что нужно: есть ли
/// такая переменная у инстанса. Если её нет, значит Create не
/// отработал, значит и список не создавался — освобождать нечего.
/// ═══════════════════════════════════════════════════════════════

if (variable_instance_exists(id, "queue_list")) {
    if (ds_exists(queue_list, ds_type_list)) {
        ds_list_destroy(queue_list);
    }
}
