/// Create obj_traffic_controller
/// @description Обход людей стороной. Пакет 260 (замена 258/259).

people_traffic_defaults();


// ═══════════════════════════════════════════════════════════════
// СОБСТВЕННАЯ СЕТКА ДЛЯ ОБХОДОВ
//
// Отдельная от global.ai_grid копия. На ней система помечает людей
// как препятствия и строит обходные маршруты.
//
// Своя сетка нужна по одной важной причине: снятие пометки через
// mp_grid_clear_cell у человека, стоящего вплотную к мебели,
// разблокировало бы клетку СТЕНЫ. Штатная ai_grid испортилась бы
// навсегда, и все в игре начали бы ходить сквозь мебель.
// Здесь ai_grid не изменяется ни разу.
// ═══════════════════════════════════════════════════════════════

global.traffic_cell_size = 16;   // как в obj_Render → Create

var _cw = ceil(room_width / global.traffic_cell_size);
var _ch = ceil(room_height / global.traffic_cell_size);

global.traffic_grid = mp_grid_create(
    0,
    0,
    _cw,
    _ch,
    global.traffic_cell_size,
    global.traffic_cell_size
);

mp_grid_add_instances(global.traffic_grid, par_objects, true);

// Флаг «сетка создана». Проверять саму сетку нечем: функции
// mp_grid_exists в GML не существует, её вызов роняет игру.
global.traffic_grid_ready = true;

// Счётчик шагов игры — по нему сетка пересобирается не чаще
// одного раза за шаг, а не на каждого пешехода отдельно.
global.traffic_frame = 0;
global.traffic_grid_frame = -1;


// ═══════════════════════════════════════════════════════════════
// НАСТРОЙКА
// ═══════════════════════════════════════════════════════════════

// Радиус личного места, пиксели.
global.traffic_radius = 17;

// На сколько пикселей вперёд человек смотрит, решая, пора ли обходить.
// Больше — начинает обходить заранее, издалека.
global.traffic_look_ahead = 46;

// Пауза между перестроениями маршрута, в шагах.
// Меньше — реагируют быстрее, но чаще считают путь.
global.traffic_detour_cooldown = 18;

// Сколько ждать, если обойти негде, до расхождения вплотную.
// 180 шагов ≈ 3 сек.
global.traffic_squeeze_steps = 180;

// Толщина «человека» в клетках сетки. 1 клетка = 16px.
// 2 — обходят по широкой дуге, 1 — впритирку.
global.traffic_cell_pad = 1;


// Выключатель: false — система отключается целиком.
global.traffic_enabled = true;
