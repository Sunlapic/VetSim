// ═══════════════════════════════════════════════════════════════
// obj_float_text → CREATE
//
// Всплывающая надпись: взлетает над персонажем и тает.
// Используется для показа полученного опыта («Терапия +2») и
// дохода у кассы («+25$»).
//
// Объект намеренно устроен как obj_speech_bubble — тот же принцип
// слежения за целью, та же схема появления и угасания. Разница в
// том, что здесь нет плашки: только сам текст с обводкой, чтобы
// надпись читалась на любом фоне и не загораживала клинику.
// ═══════════════════════════════════════════════════════════════

// ── ЦЕЛЬ ──
// Если target задан, надпись летит вместе с персонажем.
// Если нет — висит на месте, где её создали (для кассы).
target = noone;

float_text = "";

// ── РАЗМЕР ШРИФТА ──
// Просили «не очень мелкий, чтобы читалось нормально».
// fnt_main в проекте — 12 пикселей, для надписи в мире этого мало,
// поэтому увеличиваем. 1.7 подобрано так, чтобы текст уверенно
// читался, но не перекрывал соседних персонажей.
text_scale = 1.70;

// ── ЦВЕТ ──
// Задаётся снаружи: опыт — светло-жёлтый, деньги — зелёный.
text_color = make_color_rgb(255, 226, 120);

// Цвет обводки. Тёмный контур — единственный способ сохранить
// читаемость и на светлом полу, и на тёмной мебели.
outline_color = make_color_rgb(28, 20, 12);

// ── ДВИЖЕНИЕ И ЖИЗНЬ ──
duration    = round(room_speed * 1.6);   // общее время жизни
life        = 0;

y_offset    = -118;   // старт: над головой
float_speed = 0.62;   // пикселей вверх за кадр
float_rise  = 0;      // накопленный подъём

// Небольшой сдвиг вбок, чтобы две надписи подряд не наложились
// друг на друга буквой в букву.
x_offset = 0;

fade_in  = 6;
fade_out = 20;

image_alpha = 0;

// ── ЛЁГКИЙ «ПОДСКОК» В НАЧАЛЕ ──
// Надпись сначала чуть увеличивается, потом возвращается к своему
// размеру. Движение занимает четверть секунды и нужно только для
// того, чтобы глаз заметил появление текста.
pop_frames = round(room_speed * 0.22);
pop_extra  = 0.28;

// Точка привязки, если цели нет.
anchor_x = x;
anchor_y = y;

// Поверх всего остального.
depth = -12000;
