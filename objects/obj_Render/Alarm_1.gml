/// Alarm 1 obj_Render
/// @description Пакет №269: загрузка сохранения после сборки комнаты.
///
/// ═══════════════════════════════════════════════════════════════
/// ПОЧЕМУ ЗАГРУЗКА ЗДЕСЬ, А НЕ В CREATE
///
/// Create объекта выполняется ДО того, как GameMaker создал остальные
/// объекты комнаты: столы, койки, точки ожидания, стартовый персонал.
///
/// Если восстанавливать сотрудников в Create, произойдёт два плохих
/// события сразу:
///   1. Загруженных врачей тут же дополнят экземпляры из комнаты —
///      штат удвоится.
///   2. Поиск свободных коек и точек ожидания ничего не найдёт,
///      потому что этих объектов ещё нет.
///
/// Alarm 1 срабатывает через один шаг, когда комната уже полностью
/// собрана. Именно поэтому загрузка живёт тут.
///
/// Alarm 0 занят потоком клиентов — не трогаем.
/// ═══════════════════════════════════════════════════════════════

alarm[1] = -1;

if (!variable_global_exists("save_load_pending")) exit;
if (!global.save_load_pending) exit;

global.save_load_pending = false;

// Защита на случай, если скрипт save_system не создан в IDE:
// игра просто начнётся с чистого листа, но не упадёт.
var _load_fn = asset_get_index("vetsim_load");

if (_load_fn == -1 || !script_exists(_load_fn)) {
    show_debug_message("[SAVE] Скрипт save_system не найден, загрузка пропущена.");
    exit;
}

if (!vetsim_save_exists()) {
    show_debug_message("[SAVE] Сохранения нет — новая игра.");
    exit;
}

if (vetsim_load()) {
    // Точки ожидания и сетка навигации уже построены в Create по
    // объектам комнаты — их пересобирать не нужно, они не зависят
    // от того, кто из персонала жив.
    //
    // А вот день для автосейва надо синхронизировать с загруженным,
    // иначе автосохранение сработает лишним разом сразу после старта.
    global.save_last_day = global.game_day;
}
