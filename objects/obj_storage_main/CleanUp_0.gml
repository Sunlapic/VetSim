/// obj_storage_main — Clean Up
///
/// ПАКЕТ 277 (задача 5): освобождение поверхности стеллажа.
///
/// Склад рисует полки не напрямую, а в поверхность, и перерисовывает
/// её только при изменении запаса — правильная оптимизация, трогать
/// её не нужно. Но события Clean Up у объекта не было, и при
/// уничтожении склада поверхность оставалась в видеопамяти.
///
/// Сейчас это ничего не ломает: склад живёт всю партию. Проблема
/// появится в разделе «Карта», где будет переезд между шестью
/// клиниками — каждый переезд подтекал бы. Дешевле закрыть сейчас.

if (variable_instance_exists(id, "shelf_surface")) {
    if (shelf_surface != -1 && surface_exists(shelf_surface)) {
        surface_free(shelf_surface);
    }

    shelf_surface = -1;
}
